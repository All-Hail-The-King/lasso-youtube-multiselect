{
  "manifest_version": 3,
  "name": "Lasso: Video Multi-Select for YouTube",
  "short_name": "Lasso",
  "version": "1.5.0",
  "description": "Click to select many YouTube videos, then add them to (or remove them from) a playlist in the order you picked them.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
