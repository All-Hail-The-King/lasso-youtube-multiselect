{
  "manifest_version": 3,
  "name": "Lasso: Video Multi-Select for YouTube",
  "short_name": "Lasso",
  "version": "1.7.1",
  "description": "Select many YouTube videos and add them to or remove them from a playlist in order, and see any playlist's total duration.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "playlist-duration.js"
      ],
      "css": [
        "content.css",
        "playlist-duration.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
